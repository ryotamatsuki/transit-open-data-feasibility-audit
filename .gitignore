# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets and local configuration
.env
.env.*
!.env.example

# Raw data: do not commit source ZIP archives or unreviewed downloads
data/raw/*
!data/raw/.gitkeep
!data/raw/source_manifest.csv
!data/raw/gtfs_download_manifest.csv
!data/raw/gtfs_history_fetch_coverage.csv
!data/raw/gtfs_history_metadata_recovery.csv
!data/raw/gtfs_excluded_registry_feeds.csv
!data/raw/links/
data/raw/links/*
!data/raw/links/fetch_status.csv
!data/raw/links/fetch_status.json
!data/raw/links/*.error.html
!data/raw/links/*response_headers.txt

# Processed snapshots: allow only the reviewed, email-free registry snapshot
data/processed/*
!data/processed/gtfs_registry_snapshot_20260929.json
!data/processed/gtfs_registry_snapshot_20260929.csv
!data/processed/gtfs_registry_snapshot_metadata.json

# Never commit downloaded archives
*.zip
*.gtfs
